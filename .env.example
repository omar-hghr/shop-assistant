# Copy this file to .env and fill in your own values. Never commit .env.

# --- Model (Groq) ---
GROQ_API_KEY=put_your_key_here
# Optional. Default is llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# --- Telegram (demo and owner replies) ---
TELEGRAM_BOT_TOKEN=put_your_token_here
OWNER_TELEGRAM_ID=put_owner_chat_id_here

# --- Email (handoff alerts and daily summary, Gmail app password) ---
EMAIL_SENDER=put_sender_email_here
EMAIL_APP_PASSWORD=put_app_password_here
# Several emails separated by commas
HANDOFF_EMAILS=owner@example.com
# Optional. If empty, HANDOFF_EMAILS is used
SUMMARY_EMAILS=

# --- Shopify (read only) ---
# Store name only, the part before .myshopify.com
SHOPIFY_STORE=put_store_name_here
SHOPIFY_CLIENT_ID=put_client_id_here
SHOPIFY_CLIENT_SECRET=put_client_secret_here
# Format YYYY-MM. Check Shopify's docs for a current version
SHOPIFY_API_VERSION=put_api_version_here

# --- WhatsApp Cloud API ---
WHATSAPP_TOKEN=put_system_user_token_here
WHATSAPP_PHONE_NUMBER_ID=put_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=choose_any_secret_text
WHATSAPP_APP_SECRET=put_meta_app_secret_here
# Optional. Default is v26.0
WHATSAPP_API_VERSION=v26.0

# --- Instagram messaging ---
INSTAGRAM_ACCESS_TOKEN=put_token_here
INSTAGRAM_ACCOUNT_ID=put_account_id_here
# Optional. If empty, WHATSAPP_APP_SECRET is used
INSTAGRAM_APP_SECRET=